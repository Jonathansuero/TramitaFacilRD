# Copia este archivo como .env y completa lo que uses. Nada aquí es obligatorio.

PORT=5000
FLASK_DEBUG=0

# Ruta de la base de datos (por defecto: instance/tramitafacil.db)
# TF_DB_PATH=/ruta/a/tramitafacil.db

# Tasas de cambio en vivo (1 = activado, 0 = usar solo las de respaldo del catálogo)
TF_TASAS_EN_VIVO=1

# Aviso por correo de cada nueva solicitud (opcional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=contraseña-de-aplicacion
# NOTIFY_TO=Jonathansuero24@gmail.com
